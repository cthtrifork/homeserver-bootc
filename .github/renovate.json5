{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  labels: [
    'dependencies',
    'automated-pr',
  ],
  dependencyDashboard: {
    enabled: true,
    title: 'Dependency Dashboard',
    labels: [
      'dependencies',
    ],
  },
  minimumReleaseAge: '2 days',
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  internalChecksFilter: 'strict',
  platformCommit: 'enabled',
  osvVulnerabilityAlerts: true,
  prHourlyLimit: 5,
  prConcurrentLimit: 10,
  vulnerabilityAlerts: {
    addLabels: [
      'vulnerability',
    ],
    additionalBranchPrefix: '',
  },
  major: {
    automerge: false,
  },
  minor: {
    automerge: false,
  },
  patch: {
    automerge: true,
  },
  automergeType: 'pr',
  platformAutomerge: false,
  ignoreTests: false,
  rebaseWhen: 'auto',
  packageRules: [
    {
      matchUpdateTypes: [
        'digest',
        'pin',
        'pinDigest',
      ],
      automerge: true,
    },
    {
      matchPackageNames: [
        'quay.io/fedora/fedora-bootc',
      ],
      dependencyDashboardApproval: true,
      groupName: 'fedora-bootc base image',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'actions',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'tools',
      automerge: true,
    },
    {
      matchPackageNames: [
        'cthtrifork/trivy-dashboard-wail3',
        'cthtrifork/harper-pad',
        'cthtrifork/kglance',
      ],
      minimumReleaseAge: null,
      groupName: null,
      automerge: true,
    },
    {
      extends: [
        'helpers:pinGitHubActionDigests',
      ],
      extractVersion: '^(?<version>v?\\d+\\.\\d+\\.\\d+)$',
      versioning: 'regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$',
      recreateWhen: 'always',
    },
    {
      matchPackageNames: [
        'renovate',
        'renovatebot/github-action',
      ],
      automerge: true,
      groupName: null,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
        '/^\\.github/actions/[^/]+/action\\.ya?ml$/',
      ],
      matchStrings: [
        '(?<depName>quay\\.io/coreos/chunkah):(?<currentValue>v?\\d[\\w.-]*)',
        '(?<depName>quay\\.io/fedora/fedora-bootc):(?<currentValue>\\d[\\w.-]*)',
        '(?<depName>docker\\.io/library/registry):(?<currentValue>\\d[\\w.-]*)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^[^/]+\\.containerfile$/',
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
        '/^\\.github/actions/[^/]+/action\\.ya?ml$/',
      ],
      matchStrings: [
        '\\S+\\s*[:=]\\s*[\'"]?(?<currentValue>[^\\s\'"]+)[\'"]?\\s+# renovate:\\s*datasource=(?<datasource>\\S+)\\s+(?:depName|packageName)=(?<depName>\\S+)',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/.*\\.sh$/',
      ],
      matchStrings: [
        '(?<depName>[^\\s"\']+)="?(?<currentValue>.[^"\'\\s]*)"?\\s+# renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<packageName>[^\\s]+)',
      ],
      datasourceTemplate: '{{{datasource}}}',
      packageNameTemplate: '{{{packageName}}}',
      versioningTemplate: 'semver',
    },
  ],
}
