# Egress gateway for the agent: everything the `claude` user (UID 1100) starts, including rootless podman,
# may only talk to the local allowlist proxy (127.0.0.1:8008 http, :8443 https/SNI) and DNS filter (127.0.0.55:53).
# The ports are ones SELinux lets the nginx (httpd_t) and dnsmasq (dnsmasq_t) domains bind: http_port_t and dns_port_t.
# 127.0.0.53 and .54 are taken by systemd-resolved.
# Rootless podman: pasta opens its host-side sockets as UID 1100, so container traffic is caught too.
# Containers that share the host network (--network=host) run their processes under the subuid range
# (100000-165535, see /etc/subuid), so that range is matched as well.
# Root, caspertdk, sshd, bootc, dnf and the proxy itself are not affected.
table inet claude_egress
delete table inet claude_egress

table inet claude_egress {
    set agent_uids {
        type uid
        flags interval
        elements = { 1100, 100000-165535 }
    }

    chain nat_out {
        type nat hook output priority -100; policy accept;
        meta skuid != @agent_uids return
        # DNS first (the resolver stub lives on 127.0.0.53), then leave other loopback traffic alone
        meta nfproto ipv4 udp dport 53 counter dnat ip to 127.0.0.55:53
        meta nfproto ipv4 tcp dport 53 counter dnat ip to 127.0.0.55:53
        ip daddr 127.0.0.0/8 return
        meta nfproto ipv4 tcp dport 443 counter redirect to :8443
        meta nfproto ipv4 tcp dport 80 counter redirect to :8008
    }

    chain filter_out {
        type filter hook output priority 0; policy accept;
        meta skuid != @agent_uids return
        # After the redirect above, allowed traffic is local; everything else (UDP/QUIC, SSH, other ports, IPv6) is
        # refused. Match the destination, not "oif lo": the packet is re-routed to loopback after the nat hook, but
        # later chains of the same hook still see the original output interface.
        ip daddr 127.0.0.0/8 accept
        ip6 daddr ::1 accept
        counter reject with icmpx admin-prohibited
    }
}
