[Unit]
Description=Claude VM egress gateway: allowlist proxies (one per agent user)
Documentation=file:///usr/share/claude-vm/egress/
After=claude-vm-egress-proxy@claude.service claude-vm-egress-proxy@claude-rc-personal.service
Requires=claude-vm-egress-proxy@claude.service claude-vm-egress-proxy@claude-rc-personal.service

[Service]
# stands for the instances, so the units that need the gateway name one service
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true

[Install]
WantedBy=multi-user.target
