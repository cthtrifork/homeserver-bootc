[Unit]
Description=Claude VM egress gateway: allowlist proxy (SNI/Host)
After=systemd-resolved.service
Wants=systemd-resolved.service

[Service]
User=nginx
Group=nginx
ExecStart=/usr/sbin/nginx -e stderr -c /usr/share/claude-vm/egress-nginx.conf
Restart=always
RestartSec=2
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
