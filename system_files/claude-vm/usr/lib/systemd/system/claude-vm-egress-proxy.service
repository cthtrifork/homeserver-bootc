[Unit]
Description=Claude VM egress gateway: allowlist proxy (Envoy: SNI/Host allowlist, GitHub token injection)
After=systemd-resolved.service claude-vm-egress-ca.service systemd-tmpfiles-setup.service
Wants=systemd-resolved.service
Requires=claude-vm-egress-ca.service

[Service]
User=envoy
Group=envoy
# the Envoy binary installed under /usr/libexec (see claude-vm.containerfile): a packaged proxy would run in httpd_t, which SELinux does not let connect to upstreams
ExecStart=/usr/libexec/claude-vm/egress-proxy --config-path /usr/share/claude-vm/egress/envoy.json --disable-hot-restart --log-level warn --log-format-escaped
Restart=always
RestartSec=2
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ReadOnlyPaths=/run/claude-vm/envoy /var/lib/claude-vm/ca

[Install]
WantedBy=multi-user.target
