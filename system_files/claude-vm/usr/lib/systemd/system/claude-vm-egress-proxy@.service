[Unit]
Description=Claude VM egress gateway: allowlist proxy for %i (iron-proxy: allowlist, GitHub token swap)
After=systemd-resolved.service claude-vm-egress-ca.service systemd-tmpfiles-setup.service
Wants=systemd-resolved.service
Requires=claude-vm-egress-ca.service
PartOf=claude-vm-egress-proxy.service

[Service]
User=ironproxy
Group=ironproxy
# one proxy per agent user, so it holds that user's token only: the ports come from proxy-<user>.env and the user's token
# directory is mounted as /run/claude-vm/egress/current (a directory, not the file, so a renamed-in new token is seen)
EnvironmentFile=/usr/share/claude-vm/egress/proxy-%i.env
ExecStart=/usr/libexec/claude-vm/egress-proxy -config /usr/share/claude-vm/egress/iron-proxy.yaml
Restart=always
RestartSec=2
LimitNOFILE=65536
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
TemporaryFileSystem=/run/claude-vm/egress:ro
BindReadOnlyPaths=/run/claude-vm/egress/%i:/run/claude-vm/egress/current
ReadOnlyPaths=/var/lib/claude-vm/ca

[Install]
WantedBy=multi-user.target
