[Unit]
Description=Claude Code Remote Control (claude-rc-personal user)
Documentation=https://code.claude.com/docs/en/remote-control
After=network-online.target systemd-tmpfiles-setup.service user@1101.service claude-vm-egress-nft.service claude-vm-egress-proxy.service claude-vm-egress-dns.service claude-vm-github-token@claude-rc-personal.service
# egress allowlist gateway: without it the agent user has no network anyway, so do not start
Requires=claude-vm-egress-nft.service claude-vm-egress-proxy.service claude-vm-egress-dns.service
Wants=network-online.target user@1101.service claude-vm-github-token@claude-rc-personal.service
# Opt-in, independent of claude-remote-control.service (start/stop each on its own): runs as its own Unix user (own home, login, podman storage). It has its own GitHub App token
# (/run/claude-vm/claude-rc-personal). Inert until that user is signed in, see docs/claude-vm/README.md.
ConditionPathExists=/var/home/claude-rc-personal/.claude/.credentials.json

[Service]
Type=simple
User=claude-rc-personal
Group=claude-rc-personal
WorkingDirectory=/var/home/claude-rc-personal/workspace
Environment=HOME=/var/home/claude-rc-personal
Environment=DISABLE_AUTOUPDATER=1
Environment=CLAUDE_VM_NAME=%H-rc-personal
# rootless podman needs a runtime dir (user@1101 is started by lingering, see 15-claude-rc-personal.conf)
Environment=XDG_RUNTIME_DIR=/run/user/1101
# /usr is read-only: global npm installs, pip --user and go install go to the home directory
Environment=NPM_CONFIG_PREFIX=/var/home/claude-rc-personal/.npm-global
Environment=PATH=/usr/libexec/claude-vm/bin:/var/home/claude-rc-personal/.npm-global/bin:/var/home/claude-rc-personal/.local/bin:/var/home/claude-rc-personal/go/bin:/usr/local/bin:/usr/bin:/usr/sbin
ExecStart=/usr/libexec/claude-vm/run-remote-control
Restart=always
RestartSec=15

# Resource limits, so parallel agents/subagents (builds, tests) cannot starve sshd or the egress gateway. Percentages are
# of the VM's RAM, so they hold at any VM size. MemoryHigh throttles first; MemoryMax is the hard cap (OOM-kills inside
# this unit only). Override per VM in /etc/systemd/system/claude-remote-control-rc-personal.service.d/*.conf.
MemoryHigh=80%
MemoryMax=90%
TasksMax=4096
LimitNOFILE=65536
CPUWeight=50

# No NoNewPrivileges/RestrictSUIDSGID: rootless podman needs the setuid newuidmap/newgidmap helpers.
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/home/claude-rc-personal /var/tmp
# No ProtectKernelTunables: it read-only-mounts parts of /proc, which stops bubblewrap (the Bash sandbox) mounting its own /proc.
ProtectKernelModules=yes
# Not ProtectControlGroups=yes: it makes /sys/fs/cgroup read-only, and rootless podman then cannot create the scope it
# asks the user manager for (user@1101.service, delegated to claude-rc-personal), so every `podman build` RUN step fails with
# "create directory /sys/fs/cgroup/...: Read-only file system". Unix permissions still confine claude to its own
# delegated subtree; the unit's cgroup and the rest of the hierarchy stay root-owned. (=private would hide
# user@1101.service from the unit's cgroup namespace, so it does not help here.)
ProtectControlGroups=no

[Install]
WantedBy=multi-user.target
