[Unit]
Description=Claude Code Remote Control
Documentation=https://code.claude.com/docs/en/remote-control
After=network-online.target systemd-tmpfiles-setup.service user@1100.service claude-vm-egress-nft.service claude-vm-egress-proxy.service claude-vm-egress-dns.service
# egress allowlist gateway: without it the agent user has no network anyway, so do not start
Requires=claude-vm-egress-nft.service claude-vm-egress-proxy.service claude-vm-egress-dns.service
Wants=network-online.target user@1100.service
# Stays inert until both manual steps are done: token seeded + `claude` signed in/trusted.
ConditionPathExists=/etc/claude-vm/github-token
ConditionPathExists=/var/home/claude/.claude/.credentials.json

[Service]
Type=simple
User=claude
Group=claude
WorkingDirectory=/var/home/claude/workspace
Environment=HOME=/var/home/claude
Environment=DISABLE_AUTOUPDATER=1
# rootless podman needs a runtime dir (user@1100 is started by lingering, see 14-claude-podman-linger.conf)
Environment=XDG_RUNTIME_DIR=/run/user/1100
# /usr is read-only: global npm installs, pip --user and go install go to the home directory
Environment=NPM_CONFIG_PREFIX=/var/home/claude/.npm-global
Environment=PATH=/var/home/claude/.npm-global/bin:/var/home/claude/.local/bin:/var/home/claude/go/bin:/usr/local/bin:/usr/bin:/usr/sbin
LoadCredential=github-token:/etc/claude-vm/github-token
ExecStart=/usr/libexec/claude-vm/run-remote-control
Restart=always
RestartSec=15

# Resource limits, so parallel agents/subagents (builds, tests) cannot starve sshd or the egress gateway. Percentages are
# of the VM's RAM, so they hold at any VM size. MemoryHigh throttles first; MemoryMax is the hard cap (OOM-kills inside
# this unit only). Override per VM in /etc/systemd/system/claude-remote-control.service.d/*.conf.
MemoryHigh=80%
MemoryMax=90%
TasksMax=4096
LimitNOFILE=65536
CPUWeight=50

# No NoNewPrivileges/RestrictSUIDSGID: rootless podman needs the setuid newuidmap/newgidmap helpers.
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/home/claude /var/tmp
# No ProtectKernelTunables: it read-only-mounts parts of /proc, which stops bubblewrap (the Bash sandbox) mounting its own /proc.
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
