[Unit]
Description=Rootless podman API for agent user %i, run as the separate UID %i-podman
Documentation=file:///usr/share/doc/claude-vm/README.md
After=network-online.target systemd-tmpfiles-setup.service claude-vm-egress-nft.service claude-vm-egress-proxy.service claude-vm-egress-dns.service
# Containers of this user are only confined to the allowlist while the gateway runs.
Requires=claude-vm-egress-nft.service claude-vm-egress-proxy.service claude-vm-egress-dns.service
Wants=network-online.target

# Why a second UID: podman started by the agent user could bind-mount anything that user can read (its login, its signing key)
# whatever flags are used. Containers started through this service run as %i-podman instead, which the kernel keeps out of
# the agent's home: see docs/claude-vm/README.md ("Containers run as a separate UID").

[Service]
Type=simple
User=%i-podman
Group=%i-podman
# The agent's own group on the socket directory (setgid, tmpfiles 16-claude-podman.conf) is what lets only that agent connect.
UMask=0007
# Root-only: gives %i-podman access to the agent's workspace (and nothing else in its home), see the script.
ExecStartPre=+/usr/libexec/claude-vm/podman-prepare %i
Environment=HOME=/var/home/%i-podman
Environment=XDG_RUNTIME_DIR=/run/claude-vm-podman-run/%i
# Root-owned settings: the agent users cannot change them. No SELinux label separation (the kernel's file permissions are the
# boundary here, and containers must read the workspace); cgroupfs because there is no systemd user manager.
Environment=CONTAINERS_CONF=/usr/share/claude-vm/podman-containers.conf
RuntimeDirectory=claude-vm-podman-run/%i
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/podman system service --time=0 unix:///run/claude-vm-podman/%i/podman.sock
Restart=always
RestartSec=5

# Same limits as the agent's own service, so a runaway container cannot starve sshd or the egress gateway.
Delegate=yes
MemoryHigh=60%
MemoryMax=80%
TasksMax=4096
LimitNOFILE=65536
CPUWeight=50

# No NoNewPrivileges/RestrictSUIDSGID: rootless podman needs the setuid newuidmap/newgidmap helpers.
PrivateTmp=yes
ProtectKernelModules=yes

[Install]
WantedBy=multi-user.target
