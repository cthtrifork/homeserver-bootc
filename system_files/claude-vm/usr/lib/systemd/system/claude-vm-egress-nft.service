[Unit]
Description=Claude VM egress gateway: firewall rules and proxy addresses for the agent users
Documentation=file:///usr/share/claude-vm/egress.nft
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target
After=local-fs.target systemd-sysusers.service
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# the proxy addresses (one per agent user and one for containers, see egress.nft): on lo, so they exist before the proxies start
ExecStart=/usr/sbin/ip addr replace 198.18.0.2/32 dev lo
ExecStart=/usr/sbin/ip addr replace 198.18.0.3/32 dev lo
ExecStart=/usr/sbin/ip addr replace 198.18.0.4/32 dev lo
# the address the proxies answer with: routed (so connect() succeeds even without a default route), not assigned to an interface
ExecStart=/usr/sbin/ip route replace 198.19.0.1/32 dev lo
ExecStart=/usr/sbin/nft -f /usr/share/claude-vm/egress.nft
ExecStop=/usr/sbin/nft delete table inet claude_egress
ExecStop=/usr/sbin/ip route del 198.19.0.1/32 dev lo
ExecStop=/usr/sbin/ip addr del 198.18.0.2/32 dev lo
ExecStop=/usr/sbin/ip addr del 198.18.0.3/32 dev lo
ExecStop=/usr/sbin/ip addr del 198.18.0.4/32 dev lo

[Install]
WantedBy=sysinit.target
