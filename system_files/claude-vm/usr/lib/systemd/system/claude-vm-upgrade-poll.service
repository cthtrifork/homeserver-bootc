[Unit]
Description=Report to the Update VMs page and ask whether to run bootc upgrade
Documentation=file:///usr/share/doc/claude-vm/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/claude-vm/poll-upgrade claude-vm
TimeoutStartSec=30
StateDirectory=claude-vm-upgrade
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
