[Unit]
Description=Claude Code interactive session that feeds the status line report (%i)
Documentation=https://code.claude.com/docs/en/statusline
After=network-online.target systemd-tmpfiles-setup.service claude-vm-egress-nft.service claude-vm-egress-proxy.service claude-vm-egress-dns.service
# egress allowlist gateway: without it the agent user has no network anyway, so do not start
Requires=claude-vm-egress-nft.service claude-vm-egress-proxy.service claude-vm-egress-dns.service
Wants=network-online.target
# Opt-in per agent user, independent of the remote-control units: sudo systemctl enable --now claude-statusline@claude
# (or @claude-rc-personal). Inert until that user is signed in.
ConditionPathExists=/var/home/%i/.claude/.credentials.json

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/var/home/%i/workspace
Environment=HOME=/var/home/%i
Environment=DISABLE_AUTOUPDATER=1
# This session needs no Remote Control, so it can turn off telemetry and background traffic. Never set these in
# managed-settings.json: both also disable feature-flag fetching, which Remote Control needs.
Environment=DISABLE_TELEMETRY=1
Environment=CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
Environment=NPM_CONFIG_PREFIX=/var/home/%i/.npm-global
Environment=PATH=/var/home/%i/.npm-global/bin:/var/home/%i/.local/bin:/usr/local/bin:/usr/bin:/usr/sbin
ExecStart=/usr/libexec/claude-vm/run-statusline-session
Restart=always
RestartSec=30

MemoryHigh=20%
MemoryMax=30%
TasksMax=512
CPUWeight=20

# Same sandbox constraints as claude-remote-control.service: no ProtectKernelTunables (bubblewrap needs /proc).
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/home/%i /var/tmp
ProtectKernelModules=yes

[Install]
WantedBy=multi-user.target
