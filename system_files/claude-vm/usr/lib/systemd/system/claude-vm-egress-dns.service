[Unit]
Description=Claude VM egress gateway: allowlist DNS filter
After=systemd-resolved.service
Wants=systemd-resolved.service

[Service]
User=dnsmasq
Group=dnsmasq
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --pid-file= --conf-file=/usr/share/claude-vm/egress-dnsmasq.conf
Restart=always
RestartSec=2
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
