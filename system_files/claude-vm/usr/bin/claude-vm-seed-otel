#!/usr/bin/bash
# Store the bearer token of the usage collector (https://otel.portableinfo.cloud, talos-gitops k8s/apps/claude-system/otel).
#   kubectl -n claude-system get secret claude-otel-token -o jsonpath='{.data.token}' | base64 -d | sudo claude-vm-seed-otel
#   sudo claude-vm-seed-otel <token-file>
# The token is read from a file or stdin, never from an argument, so it stays out of shell history and `ps`.
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "Run as root: sudo $0 ..." >&2; exit 1; }
[[ $# -le 1 ]] || { echo "Usage: $0 [token-file]" >&2; exit 1; }

token="$(tr -d '[:space:]' <"${1:-/dev/stdin}")"
[[ "$token" =~ ^[A-Za-z0-9._~-]{20,}$ ]] || { echo "That does not look like the collector's token." >&2; exit 1; }

install -d -m 0750 -o root -g claude-otel /etc/claude-otel
tmp="$(mktemp /etc/claude-otel/.token.XXXXXX)"
chmod 0640 "$tmp"
chgrp claude-otel "$tmp"
printf '%s\n' "$token" >"$tmp"
mv -f "$tmp" /etc/claude-otel/token
echo "Token stored in /etc/claude-otel/token (root:claude-otel, 0640). Claude Code reads it on the next export."
