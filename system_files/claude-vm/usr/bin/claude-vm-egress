#!/usr/bin/bash
# Show what the egress gateway allows and what it blocked.
#   claude-vm-egress allowed             # the allowlist (a domain also covers its subdomains)
#   claude-vm-egress blocked [--raw] [journalctl args]
#                                        # refused HTTPS/HTTP requests since boot, one line per host: count, last seen,
#                                        # scheme, host (--raw: every refused request as JSON; other args go to journalctl,
#                                        # e.g. --since -1h).
#                                        # Reading the journal needs root or the adm/wheel group: use sudo.
# DNS refusals are not logged, so a name that never resolves does not show up under "blocked".
set -euo pipefail

case "${1:-}" in
allowed)
    # the allowlist transform's domains, without the "*." in front of each
    exec yq '.transforms[] | select(.name == "allowlist") | .config.domains[] | .[2:]' /usr/share/claude-vm/egress/iron-proxy.yaml
    ;;
blocked)
    shift
    raw=0
    if [[ "${1:-}" == --raw ]]; then
        raw=1
        shift
    fi
    # iron-proxy logs one JSON audit line per request to the journal: a request it refused has audit.action "reject"
    # (rejected_by: allowlist, secrets, ...). Tests and the proxy's own noise stay out.
    refused='select(.msg == "request" and .audit.action == "reject")'
    if ((raw)); then
        exec journalctl --no-pager -o cat -b -u 'claude-vm-egress-proxy@*' "$@" | jq -c "$refused"
    fi
    # one line per host: count, last time, scheme, host (https is a request with an SNI; iron-proxy says mode "mitm" for plain HTTP too)
    journalctl --no-pager -o cat -b -u 'claude-vm-egress-proxy@*' "$@" |
        jq -Rr "fromjson? | $refused | [.time, (if (.audit.sni // \"\") != \"\" then \"https\" else \"http\" end), ((.audit.host // \"(no host)\") | sub(\":[0-9]+\$\"; \"\"))] | join(\" \")" |
        awk '{ key = $2 " " $3; count[key]++; last[key] = $1 } END { for (k in count) print count[k], last[k], k }' |
        sort -k1,1nr -k4,4
    ;;
*)
    echo "usage: claude-vm-egress allowed | blocked [journalctl args]" >&2
    exit 2
    ;;
esac
