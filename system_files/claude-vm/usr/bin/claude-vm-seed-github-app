#!/usr/bin/bash
# Store the credentials of the GitHub App one agent user acts as, then mint its first token. Every user has its own App.
#   sudo claude-vm-seed-github-app <user> <app-id> <installation-id> <private-key.pem>
#   sudo claude-vm-seed-github-app <user> <app-id> <installation-id> < private-key.pem
# The key is read from a file or stdin, never from an argument, so it stays out of shell history and `ps`.
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "Run as root: sudo $0 ..." >&2; exit 1; }
[[ $# -ge 3 && $# -le 4 ]] || { echo "Usage: $0 <user> <app-id> <installation-id> [private-key.pem]" >&2; exit 1; }

user="$1"
app_id="$2"
installation_id="$3"
[[ "$user" =~ ^claude(-[a-z0-9-]+)?$ ]] && id -u "$user" >/dev/null 2>&1 || { echo "User must be an agent user (claude, claude-rc-personal)." >&2; exit 1; }
[[ "$app_id" =~ ^[0-9]+$ ]] || { echo "App ID must be a number." >&2; exit 1; }
[[ "$installation_id" =~ ^[0-9]+$ ]] || { echo "Installation ID must be a number." >&2; exit 1; }

key="$(cat "${4:-/dev/stdin}")"
openssl pkey -noout <<<"$key" 2>/dev/null || { echo "That is not a valid PEM private key." >&2; exit 1; }

dir="/etc/claude-vm/github-app/$user"
install -d -m 0700 -o root -g root /etc/claude-vm /etc/claude-vm/github-app "$dir"
for f in app-id installation-id private-key.pem; do
    tmp="$(mktemp "$dir/.$f.XXXXXX")"
    chmod 0600 "$tmp"
    case "$f" in
    app-id) printf '%s\n' "$app_id" >"$tmp" ;;
    installation-id) printf '%s\n' "$installation_id" >"$tmp" ;;
    *) printf '%s\n' "$key" >"$tmp" ;;
    esac
    mv -f "$tmp" "$dir/$f"
done
echo "App credentials for $user stored in $dir (root-only, 0600)."

systemctl enable --now "claude-vm-github-token@$user.timer"
systemctl start "claude-vm-github-token@$user.service"
echo "Token minted. It is refreshed every 30 minutes by claude-vm-github-token@$user.timer."

if [[ $user == claude ]]; then
    systemctl restart --no-block claude-remote-control.service || true
else
    systemctl try-restart --no-block "claude-remote-control-${user#claude-}.service" || true
fi
