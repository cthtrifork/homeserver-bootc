#!/usr/bin/bash
# Started by claude-statusline@.service. `claude remote-control` is a server with no terminal UI, so it never runs the
# managed statusLine (statusline-report). An interactive claude in a detached tmux does, and the plan limits only
# refresh on an API reply, so a one-word prompt goes in every STATUSLINE_PING_INTERVAL seconds (/clear keeps the
# context empty). Exits when claude does, so systemd restarts it.
set -euo pipefail

session=statusline
interval="${STATUSLINE_PING_INTERVAL:-600}"

tmux kill-session -t "$session" 2>/dev/null || true
tmux new-session -d -s "$session" -x 120 -y 30 'exec claude --model haiku'
trap 'tmux kill-session -t "$session" 2>/dev/null || true' EXIT
trap 'exit 0' TERM INT

# sleep in the background so a TERM from systemd is handled at once
nap() { sleep "$1" & wait $! || true; }

nap 30
while tmux has-session -t "$session" 2>/dev/null; do
    tmux send-keys -t "$session" '/clear' Enter
    nap 3
    tmux send-keys -t "$session" 'ok' Enter
    nap "$interval"
done
