#!/usr/bin/bash
# `gh` for the agent users. The agent holds no GitHub token: the egress gateway adds the user's current GitHub App token to
# every request to GitHub (see docs/claude-vm/README.md), replacing whatever Authorization header the client sends. `gh` (and
# `gh auth git-credential`, which /etc/gitconfig runs) only refuse to work without some token, so give them a placeholder.
# Comes first on the service's PATH.
set -euo pipefail

export GH_TOKEN=injected-by-the-egress-gateway
exec /usr/bin/gh "$@"
