#!/usr/bin/bash
# Builds the agent's egress allowlist and the two small files the static proxy/DNS configs include:
#   $out/allow.txt          normalized domains, one per line (a domain also covers its subdomains)
#   $out/nginx-allow.map    ".domain 1;" lines, included by /usr/share/claude-vm/egress-nginx.conf
#   $out/dnsmasq-servers    "server=/domain/resolver" lines, included by /usr/share/claude-vm/egress-dnsmasq.conf
# Sources: sandbox.network.allowedDomains from the managed settings, plus plain-text lists (one domain per line,
# "#" comments, optional "*." prefix). An invalid entry is reported and skipped; an empty result is an error.
#
# EGRESS_ROOT (default: none) prefixes every path, so the script can be run against a scratch tree.
set -euo pipefail
shopt -s nullglob

root="${EGRESS_ROOT:-}"
resolver=127.0.0.53   # systemd-resolved stub; the proxy and dnsmasq are not subject to the agent's firewall rules
out="$root/run/claude-vm/egress"
settings=("$root"/etc/claude-code/managed-settings.json "$root"/etc/claude-code/managed-settings.d/*.json)
lists=("$root"/usr/share/claude-vm/egress-extra.txt "$root"/etc/claude-vm/egress-extra.d/*.txt)

# dot-separated DNS labels, at least two; purely numeric names (IPv4 literals) are not hostnames
label='[a-z0-9]([a-z0-9-]*[a-z0-9])?'
domain_re="^${label}(\\.${label})+\$"
numeric_re='^[0-9.]+$'

candidates() {
    jq -r '.sandbox.network.allowedDomains[]?' "${settings[@]}"
    cat "${lists[@]}"
}

normalize() {
    sed -e 's/#.*//' -e 's/[[:space:]]//g' -e 's/^\*\.//' -e '/^$/d' | tr '[:upper:]' '[:lower:]' | sort -u
}

all="$(candidates | normalize)"
valid="$(grep -E "$domain_re" <<<"$all" | grep -Ev "$numeric_re" || true)"
grep -vxFf <(echo "$valid") <<<"$all" | sed 's/^/egress-generate: ignoring invalid entry: /' >&2 || true
[[ -n "$valid" ]] || { echo "egress-generate: empty allowlist" >&2; exit 1; }

install -d -m 0755 "$out"
# write each file whole, then rename, so a reader never sees a partial file
emit() { local f="$out/$1"; shift; "$@" >"$f.tmp"; mv -f "$f.tmp" "$f"; }
emit allow.txt        cat <<<"$valid"
emit nginx-allow.map  sed 's/.*/.&  1;/' <<<"$valid"
emit dnsmasq-servers  sed "s#.*#server=/&/${resolver}#" <<<"$valid"

echo "egress-generate: $(wc -l <<<"$valid") domains"
