#!/usr/bin/bash
# Runs as root (claude-vm-egress-ca.service) before the egress proxies. iron-proxy ends TLS for every allowlisted host (to swap
# the GitHub token in), so the agents and containers must trust a private CA: made here once, on first boot, and kept across image
# updates. The key is readable by the proxy user only and never in the image. The certificate goes into the system trust store.
set -euo pipefail

dir=/var/lib/claude-vm/ca
anchor=/etc/pki/ca-trust/source/anchors/claude-vm-egress-ca.pem

if [[ ! -s $dir/ca.key || ! -s $dir/ca.crt ]]; then
    (
        umask 077
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
            -subj "/CN=claude-vm egress gateway CA" \
            -addext "basicConstraints=critical,CA:TRUE" -addext "keyUsage=critical,keyCertSign" \
            -keyout "$dir/ca.key" -out "$dir/ca.crt"
    )
    chown root:ironproxy "$dir/ca.key"
    chmod 0640 "$dir/ca.key"
    chmod 0644 "$dir/ca.crt"
fi

if ! cmp -s "$dir/ca.crt" "$anchor"; then
    install -m 0644 "$dir/ca.crt" "$anchor"
    # Not `update-ca-trust extract` here: atomic-update-ca-trust.service runs it by itself when the anchors change, and two runs
    # at once fail with "ln: ... File exists". Starting the unit waits for a run that is already going.
    systemctl start atomic-update-ca-trust.service
fi
