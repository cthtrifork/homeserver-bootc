#!/usr/bin/bash
# otelHeadersHelper of managed-settings.json: Claude Code runs it as the agent user and sends what it prints as extra
# headers of every OpenTelemetry export. The token is read on every call, so a re-seeded token needs no restart. Before
# claude-vm-seed-otel ran there is none: no headers, and the collector answers the exports with 401.
set -euo pipefail

token_file=/etc/claude-otel/token
if [[ -r "$token_file" ]]; then
    jq -n --rawfile t "$token_file" '{Authorization: ("Bearer " + ($t | rtrimstr("\n")))}'
else
    echo '{}'
fi
