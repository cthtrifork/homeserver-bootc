#!/usr/bin/bash
# Runs as root (claude-vm-github-token@<user>.service). Signs a short-lived JWT with that user's GitHub App private
# key, trades it for a one-hour installation token and hands the token to the egress gateway (iron-proxy), which swaps it in for
# the placeholder in that user's requests to GitHub. The private key never leaves /etc/claude-vm and the agent user never sees the token at all.
set -euo pipefail

user="${1:?Usage: $0 <user>}"
src="/etc/claude-vm/github-app/$user"
dest="/run/claude-vm/egress/$user/github-token"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

app_id="$(tr -d '[:space:]' <"$src/app-id")"
installation_id="$(tr -d '[:space:]' <"$src/installation-id")"

now="$(date +%s)"
header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64url)"
signature="$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$src/private-key.pem" | b64url)"

# No "permissions" or "repositories" in the request: the token gets everything the App was granted on the
# repositories it is installed on. Narrow it in the App's settings, not here.
token="$(curl -fsS --max-time 30 -X POST \
    -H "Authorization: Bearer $header.$payload.$signature" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/${installation_id}/access_tokens" | jq -er .token)"

# iron-proxy re-reads the file (ttl 1m) and uses its exact contents, so no trailing newline. Written to a temporary file first
# and renamed, so the gateway never reads half a token.
tmp="$(mktemp "/run/claude-vm/egress/$user/.github-token.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
chown root:ironproxy "$tmp"
chmod 0640 "$tmp"
printf '%s' "$token" >"$tmp"
mv -f "$tmp" "$dest"
trap - EXIT
echo "github token refreshed for $user"
