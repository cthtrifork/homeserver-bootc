#!/usr/bin/bash
# Runs as root (claude-vm-github-token@<user>.service). Signs a short-lived JWT with that user's GitHub App private
# key, trades it for a one-hour installation token and publishes the token for that user only. The private key
# never leaves /etc/claude-vm; the agent user only ever sees its own one-hour token.
set -euo pipefail

user="${1:?Usage: $0 <user>}"
src="/etc/claude-vm/github-app/$user"
dest="/run/claude-vm/$user/github-token"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

app_id="$(tr -d '[:space:]' <"$src/app-id")"
installation_id="$(tr -d '[:space:]' <"$src/installation-id")"

now="$(date +%s)"
header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64url)"
signature="$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$src/private-key.pem" | b64url)"

# No "permissions" or "repositories" in the request: the token gets everything the App was granted on the
# repositories it is installed on. Narrow it in the App's settings, not here.
token="$(curl -fsS --max-time 30 -X POST \
    -H "Authorization: Bearer $header.$payload.$signature" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/${installation_id}/access_tokens" | jq -er .token)"

install -d -m 0750 -o root -g "$user" "/run/claude-vm/$user"
tmp="$(mktemp "/run/claude-vm/$user/.github-token.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
chown "root:$user" "$tmp"
chmod 0640 "$tmp"
printf '%s\n' "$token" >"$tmp"
mv -f "$tmp" "$dest"
trap - EXIT
echo "github-token refreshed for $user"
