#!/usr/bin/bash
# Runs as root (claude-vm-github-token@<user>.service). Signs a short-lived JWT with that user's GitHub App private
# key, trades it for a one-hour installation token and hands the token to the egress gateway (Envoy), which adds it to that
# user's requests to GitHub. The private key never leaves /etc/claude-vm and the agent user never sees the token at all.
set -euo pipefail

user="${1:?Usage: $0 <user>}"
src="/etc/claude-vm/github-app/$user"
secrets="/run/claude-vm/envoy"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

app_id="$(tr -d '[:space:]' <"$src/app-id")"
installation_id="$(tr -d '[:space:]' <"$src/installation-id")"

now="$(date +%s)"
header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64url)"
signature="$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$src/private-key.pem" | b64url)"

# No "permissions" or "repositories" in the request: the token gets everything the App was granted on the
# repositories it is installed on. Narrow it in the App's settings, not here.
token="$(curl -fsS --max-time 30 -X POST \
    -H "Authorization: Bearer $header.$payload.$signature" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/${installation_id}/access_tokens" | jq -er .token)"

# Envoy reads each as an SDS secret and picks up a replaced file by itself. The names are those of the intercept groups in
# build_files/claude-vm/egress_allowlist.py: "api" (api.github.com) takes the token as it is (Envoy prefixes "Bearer "),
# "git" (github.com, git over HTTPS) wants HTTP Basic with the user name x-access-token (Envoy prefixes "Basic ").
# The value goes in on stdin: a command-line argument would show up in /proc/<pid>/cmdline.
publish() {
    local name="$1" tmp
    tmp="$(mktemp "$secrets/.$user-$name.XXXXXX")"
    trap 'rm -f "$tmp"' EXIT
    jq -Rsc '{resources: [{"@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.Secret", name: "credential", generic_secret: {secret: {inline_string: .}}}]}' >"$tmp"
    chown root:envoy "$tmp"
    chmod 0640 "$tmp"
    mv -f "$tmp" "$secrets/$user-$name.json"
    trap - EXIT
}
printf '%s' "$token" | publish api
printf 'x-access-token:%s' "$token" | base64 -w0 | publish git
echo "github token refreshed for $user"
