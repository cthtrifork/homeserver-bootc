{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_logout)",
      "Edit(~/.profile)",
      "Edit(~/.config/systemd/**)",
      "Edit(~/.config/autostart/**)",
      "Edit(~/.config/containers/systemd/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)"
    ],
    "allow": [
      "Bash",
      "Bash(podman *)",
      "Bash(podman-compose *)",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_context7_context7__*",
      "mcp__context7__*",
      "mcp__claude_ai_Google_Calendar__*",
      "Skill(project-management:*)",
      "Skill(plugin-dev:*)",
      "Skill(pr-review-toolkit:*)",
      "Skill(frontend-design:*)"
    ],
    "additionalDirectories": [
      "~"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "podman *",
      "podman-compose *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm-global",
        "~/.npm",
        "~/.local",
        "~/.cache",
        "~/go"
      ],
      "denyRead": [
        "~/.claude/.credentials.json"
      ],
      "denyWrite": [
        "~/.bashrc",
        "~/.bash_profile",
        "~/.bash_logout",
        "~/.profile",
        "~/.config/systemd",
        "~/.config/autostart",
        "~/.config/containers/systemd",
        "~/.ssh",
        "~/.gitconfig",
        "~/.config/git"
      ]
    },
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "anthropic.com",
        "*.anthropic.com",
        "api.first.org",
        "*.api.first.org",
        "astral.sh",
        "*.astral.sh",
        "blob.core.windows.net",
        "*.blob.core.windows.net",
        "bun.sh",
        "*.bun.sh",
        "cgr.dev",
        "*.cgr.dev",
        "claude.ai",
        "*.claude.ai",
        "claude.com",
        "*.claude.com",
        "cloudflare.com",
        "*.cloudflare.com",
        "context7.com",
        "*.context7.com",
        "crates.io",
        "*.crates.io",
        "debian.org",
        "*.debian.org",
        "developer.apple.com",
        "*.developer.apple.com",
        "developer.mozilla.org",
        "*.developer.mozilla.org",
        "developers.redhat.com",
        "*.developers.redhat.com",
        "docker.com",
        "*.docker.com",
        "docker.io",
        "*.docker.io",
        "docs.python.org",
        "*.docs.python.org",
        "fedoraproject.org",
        "*.fedoraproject.org",
        "files.pythonhosted.org",
        "*.files.pythonhosted.org",
        "fluxcd.io",
        "*.fluxcd.io",
        "frame.claudeusercontent.com",
        "*.frame.claudeusercontent.com",
        "frame.staging.claudeusercontent.com",
        "*.frame.staging.claudeusercontent.com",
        "gcr.io",
        "*.gcr.io",
        "ghcr.io",
        "*.ghcr.io",
        "github.com",
        "*.github.com",
        "githubassets.com",
        "*.githubassets.com",
        "githubcopilot.com",
        "*.githubcopilot.com",
        "githubusercontent.com",
        "*.githubusercontent.com",
        "go.dev",
        "*.go.dev",
        "json.schemastore.org",
        "*.json.schemastore.org",
        "kubernetes.io",
        "*.kubernetes.io",
        "mcr.microsoft.com",
        "*.mcr.microsoft.com",
        "nodejs.org",
        "*.nodejs.org",
        "npmjs.com",
        "*.npmjs.com",
        "npmjs.org",
        "*.npmjs.org",
        "nuget.org",
        "*.nuget.org",
        "nvd.nist.gov",
        "*.nvd.nist.gov",
        "oneuptime.com",
        "*.oneuptime.com",
        "osv.dev",
        "*.osv.dev",
        "plugins.gradle.org",
        "*.plugins.gradle.org",
        "portableinfo.cloud",
        "*.portableinfo.cloud",
        "proxy.golang.org",
        "*.proxy.golang.org",
        "pypi.org",
        "*.pypi.org",
        "quay.io",
        "*.quay.io",
        "readthedocs.io",
        "*.readthedocs.io",
        "registry.access.redhat.com",
        "*.registry.access.redhat.com",
        "registry.k8s.io",
        "*.registry.k8s.io",
        "repo.maven.apache.org",
        "*.repo.maven.apache.org",
        "rubygems.org",
        "*.rubygems.org",
        "rustup.rs",
        "*.rustup.rs",
        "s3.amazonaws.com",
        "*.s3.amazonaws.com",
        "security.snyk.io",
        "*.security.snyk.io",
        "stackoverflow.com",
        "*.stackoverflow.com",
        "static.rust-lang.org",
        "*.static.rust-lang.org",
        "storage.googleapis.com",
        "*.storage.googleapis.com",
        "sum.golang.org",
        "*.sum.golang.org",
        "wails.io",
        "*.wails.io",
        "webkit.org",
        "*.webkit.org",
        "wikipedia.org",
        "*.wikipedia.org",
        "www.cisa.gov",
        "*.www.cisa.gov"
      ]
    }
  },
  "allowManagedHooksOnly": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-vm/session-start-note"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.portableinfo.cloud",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta",
    "OTEL_RESOURCE_ATTRIBUTES": "environment=claude-vm"
  }
}
