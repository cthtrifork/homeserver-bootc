{
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_logout)",
      "Edit(~/.profile)",
      "Edit(~/.config/systemd/**)",
      "Edit(~/.config/autostart/**)",
      "Edit(~/.config/containers/systemd/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(yamllint *)",
      "Bash(hadolint *)",
      "Bash(actionlint *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(od *)",
      "Bash(printenv *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "podman *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm-global",
        "~/.npm",
        "~/.local",
        "~/.cache",
        "~/go"
      ],
      "denyRead": [
        "~/.claude/.credentials.json"
      ],
      "denyWrite": [
        "~/.bashrc",
        "~/.bash_profile",
        "~/.bash_logout",
        "~/.profile",
        "~/.config/systemd",
        "~/.config/autostart",
        "~/.config/containers/systemd",
        "~/.ssh",
        "~/.gitconfig",
        "~/.config/git"
      ]
    },
    "autoAllowBashIfSandboxed": true
  },
  "allowManagedHooksOnly": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-vm/session-start-note"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
