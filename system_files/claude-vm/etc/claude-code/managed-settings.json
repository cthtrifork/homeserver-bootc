{
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["podman *"],
    "filesystem": {
      "allowWrite": ["~/.npm-global", "~/.npm", "~/.local", "~/.cache", "~/go"],
      "denyRead": ["~/.claude/.credentials.json"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org"
      ]
    }
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
