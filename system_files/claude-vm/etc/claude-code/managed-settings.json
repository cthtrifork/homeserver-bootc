{
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "podman *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm-global",
        "~/.npm",
        "~/.local",
        "~/.cache",
        "~/go"
      ],
      "denyRead": [
        "~/.claude/.credentials.json"
      ]
    }
  },
  "allowManagedHooksOnly": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-vm/session-start-note"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
