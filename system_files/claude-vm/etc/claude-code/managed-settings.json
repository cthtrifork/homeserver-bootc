{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_logout)",
      "Edit(~/.profile)",
      "Edit(~/.config/systemd/**)",
      "Edit(~/.config/autostart/**)",
      "Edit(~/.config/containers/systemd/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)"
    ],
    "allow": [
      "Bash",
      "Bash(podman *)",
      "Bash(podman-compose *)",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_context7_context7__*",
      "mcp__context7__*",
      "mcp__claude_ai_Google_Calendar__*",
      "Skill(project-management:*)",
      "Skill(plugin-dev:*)",
      "Skill(pr-review-toolkit:*)",
      "Skill(frontend-design:*)"
    ],
    "additionalDirectories": [
      "~"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "podman *",
      "podman-compose *",
      "chromium-browser *",
      "/usr/bin/chromium-browser *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm-global",
        "~/.npm",
        "~/.local",
        "~/.cache",
        "~/go"
      ],
      "denyRead": [
        "~/.claude/.credentials.json"
      ],
      "denyWrite": [
        "~/.bashrc",
        "~/.bash_profile",
        "~/.bash_logout",
        "~/.profile",
        "~/.config/systemd",
        "~/.config/autostart",
        "~/.config/containers/systemd",
        "~/.ssh",
        "~/.gitconfig",
        "~/.config/git"
      ]
    },
    "autoAllowBashIfSandboxed": true
  },
  "allowManagedHooksOnly": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/libexec/claude-vm/session-start-note"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel.portableinfo.cloud/api/v1/otlp",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta",
    "OTEL_RESOURCE_ATTRIBUTES": "environment=claude-vm",
    "OTEL_METRICS_INCLUDE_SESSION_ID": "false",
    "OTEL_METRICS_INCLUDE_ACCOUNT_UUID": "false"
  }
}
