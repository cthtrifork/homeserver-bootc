[Unit]
Description=Install the VS Code extensions for %i
# Started by bootc-vscode-extensions@%i.timer, not by a target: a target waits for the services it wants, and this one
# waits for the network. After the dotfiles (settings.json) are in place.
After=bootc-user-setup@%i.service
Wants=bootc-user-setup@%i.service

[Service]
Type=oneshot
User=%i
ExecStart=/usr/libexec/vscode-extensions
TimeoutStartSec=15min
