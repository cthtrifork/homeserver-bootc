[Unit]
Description=Hosted (web)terminal
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/kasmweb/terminal:1.19.0@sha256:4403ce7d6980a44187a8a64046fdbc352abc2d7cb15f904988c2a0927fcd8417
Network=host
PublishPort=6901:6901

Environment=VNC_PW=password

[Service]
Restart=always

[Install]
WantedBy=multi-user.target