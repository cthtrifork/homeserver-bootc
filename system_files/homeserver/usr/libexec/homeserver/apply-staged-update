#!/usr/bin/bash
# Run as root by bootc-fetch-apply-updates.service after `bootc upgrade`.
# Reboots into a staged image only when nobody would notice: otherwise the image stays staged and the
# next nightly check tries again (or the next reboot applies it). Set FORCE=1 to skip the checks.
set -euo pipefail

log() { echo "apply-staged-update: $*"; }

staged=$(bootc status --format json | jq -r '.status.staged // empty')
if [[ -z "$staged" ]]; then
    log "nothing staged"
    exit 0
fi

if [[ "${FORCE:-0}" != 1 ]]; then
    # Someone is logged in (ssh, console, desktop)
    if [[ -n "$(loginctl list-sessions --no-legend 2>/dev/null)" ]]; then
        log "deferred: users are logged in"
        exit 0
    fi
    # Running virtual machines would be shut down by the reboot
    if command -v virsh >/dev/null && [[ -n "$(virsh -q list --state-running 2>/dev/null)" ]]; then
        log "deferred: virtual machines are running"
        exit 0
    fi
    # Busy: the 15 minute load average is above one per two cores
    read -r _ _ load15 _ < /proc/loadavg
    if awk -v l="$load15" -v c="$(nproc)" 'BEGIN { exit !(l > c / 2) }'; then
        log "deferred: load average $load15 is high"
        exit 0
    fi
fi

log "rebooting into the staged image"
systemctl reboot
