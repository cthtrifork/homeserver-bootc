[Unit]
Description=Report to the Update VMs page and ask whether to run bootc upgrade
ConditionPathExists=/run/vmupgrade/token
After=network-online.target run-vmupgrade.mount
Wants=network-online.target run-vmupgrade.mount

[Service]
Type=oneshot
ExecStart=/usr/libexec/vm-upgrade-poll homeserver
TimeoutStartSec=30
StateDirectory=vm-upgrade
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
